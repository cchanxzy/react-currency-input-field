// Type-checks everything: the library, its unit tests, the demo app, the
// Playwright tests and the tool configs. Editors use this file, so it has
// to include every TypeScript file. The build uses tsconfig.build.json.
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["es2017", "es7", "es6", "dom"],
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "jsx": "react",
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "playwright.config.ts", "jest.config.ts"]
}
