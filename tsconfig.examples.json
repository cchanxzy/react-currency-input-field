// Type-checks the code outside the library and its unit tests: the demo
// app, the Playwright tests and the tool configs.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["src/examples", "tests", "playwright.config.ts", "jest.config.ts"]
}
